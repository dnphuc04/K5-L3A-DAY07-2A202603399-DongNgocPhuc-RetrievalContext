# Reference only: runtime reads exported environment or <day6-root>/starter/.env.
# Never put real credentials in this tracked example.
OPENAI_API_KEY=replace_with_your_own_key
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:PORT/DATABASE
# Restore only: must point at a NEW database.
DAY7_RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:PORT/NEW_DATABASE
